{
  "name": "functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Jairus Portfolio",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
